# secrets / credentials
CF_API_KEY.txt
*.key
*.pem
*.pfx
.env
.env.*

# tokens / secrets droppings
*token*
secret*

# DENY BY DEFAULT: everything is ignored unless explicitly allowed below.
# A new file that isn't allowlisted stays invisible to `git status` and cannot
# reach the published package. To track a new game file, allowlist it here
# first, then `git add` it.
*
!*/

# explicitly allowed: game files, player docs, release infra
!.gitignore
!.pkgmeta
!*.lua
!*.toc
!CHANGELOG.md
!README.md
!preview.gif
!/Fonts/*.ttf
!/Fonts/Licenses/*.txt
!/.github/workflows/release.yml

# local-only, never tracked even though the allowlist above would permit them
AGENTS.md
AGENTS_MEMORY.md
tests/
