package-as: Floating_Combat_Alert
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# Ship only .lua + .toc + CHANGELOG.md + the bundled Fonts/ folder (fonts and
# their licences); this addon has no logo file. Every other tracked file must
# be listed below.
ignore:
    - README.md
    - preview.gif
    - tests
    - .gitignore
    - .gitattributes
    - .github
    # backup: gitignored and untracked, never packaged either way
    - AGENTS.md
    - AGENTS_MEMORY.md
